{%- style -%}
  .divider-container-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    box-sizing: border-box;
  }

  .divider-line-{{ section.id }} {
    width: 100%;
    height: {{ section.settings.divider_height }}px;
    /* Uses custom color if picked, otherwise falls back to the scheme's text/border color variables */
    background-color: {% if section.settings.divider_color != blank and section.settings.divider_color != 'rgba(0,0,0,0)' %}{{ section.settings.divider_color }}{% else %}rgba(var(--color-foreground), 0.2){% endif %};
    border: none;
    margin: 0;
    padding: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient divider-container-{{ section.id }}">
  <div class="divider-line-{{ section.id }}"></div>
</div>

{% schema %}
{
  "name": "Custom Divider",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Custom Divider Color (Override)",
      "info": "Leave blank or transparent to use the scheme's default line color."
    },
    {
      "type": "header",
      "content": "Divider Styling"
    },
    {
      "type": "range",
      "id": "divider_height",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Divider Thickness (Height)",
      "default": 2
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Divider"
    }
  ]
}
{% endschema %}