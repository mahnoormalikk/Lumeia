{%- doc -%}
  Lumeia header localization selector (Feel-style).
  Reuses Pebble's <dropdown-localization-component> JS + localization-form panel,
  but the trigger button shows the FLAG + both language endonym names (e.g. English / العربية)
  with the active one marked — instead of Pebble's currency/iso-code button.

  @param {string} block_id - Unique id for the panel form.
  @param {boolean} [show_country] - Show the country list in the panel.
  @param {boolean} [show_language] - Show the language toggle in the panel.
  @param {boolean} [enable_hover] - Desktop only: open the panel on hover (else click).
{%- enddoc -%}
{%- liquid
  assign show_country = show_country | default: true, allow_false: true
  assign show_language = show_language | default: true, allow_false: true
  assign enable_hover = enable_hover | default: false, allow_false: true
  assign cur_lang = localization.language
  assign cur_country = localization.country
-%}
{%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  <dropdown-localization-component class="dropdown-localization lumeia-loc block relative">
    <button
      type="button"
      class="dropdown-localization__button lumeia-loc__btn button-unstyled cursor-pointer relative z-0"
      aria-expanded="false"
      ref="toggle"
      on:click="/toggleSelector"
    >
      <span class="visually-hidden">{{- 'accessibility.localization_region_and_language' | t -}}</span>
      <span
        class="icon-flag lumeia-loc__flag block"
        style="background-image: url({{- cur_country | image_url: width: 32 }});"
      ></span>
      <span class="lumeia-loc__langs">
        {%- for lang in localization.available_languages -%}
          <span
            lang="{{ lang.iso_code }}"
            class="lumeia-loc__lang{% if lang.iso_code == cur_lang.iso_code %} is-active{% endif %}"
          >
            {{- lang.endonym_name | capitalize -}}
          </span>
        {%- endfor -%}
      </span>
      {% render 'icon', icon: 'caret-down', size: 'extra-small', class: 'dropdown-localization__button-arrow shrink-0' %}
    </button>
    {%- capture localization_popover -%}
      {{ 'component-localization-dropdown.css' | asset_url | stylesheet_tag }}
      <div class="localization-wrapper lumeia-loc__panel absolute color-background opacity-0" hidden ref="panel">
        {% render 'lumeia-localization-form', show_country: show_country, show_language: show_language, block_id: block_id %}
      </div>
    {%- endcapture -%}
    <template ref="template">{{ localization_popover }}</template>
  </dropdown-localization-component>
  {%- comment -%} Self-contained behaviour for the selector. Emitted once (this snippet renders on
    desktop and stays in the DOM on mobile via `hidden lg:flex`), so the delegated listener covers
    the drawer panel too. {%- endcomment -%}
  <script>
    (function () {
      if (window.__lumeiaLocInit) return;
      window.__lumeiaLocInit = true;
      {%- comment -%} Language switching is now plain anchor links (lumeia-localization-form.liquid),
        which navigate reliably on every device — no JS needed (the old form-submit was swallowed
        inside the mobile drawer dialog). {%- endcomment -%}
      {%- if enable_hover -%}
      // Desktop hover-open (like Feel). Pointer + ≥1024px only, so touch/mobile keep tap-to-open.
      function initHover() {
        if (!window.matchMedia('(min-width: 1024px) and (hover: hover)').matches) return;
        document.querySelectorAll('.header__localization--desktop dropdown-localization-component').forEach(function (el) {
          if (el.dataset.lumeiaHoverBound) return;
          el.dataset.lumeiaHoverBound = '1';
          var t;
          el.addEventListener('mouseenter', function () {
            clearTimeout(t);
            if (el.isHidden && typeof el.toggleSelector === 'function') el.toggleSelector();
          });
          el.addEventListener('mouseleave', function () {
            t = setTimeout(function () { if (typeof el.hidePanel === 'function') el.hidePanel(); }, 120);
          });
        });
      }
      if (document.readyState !== 'loading') initHover();
      else document.addEventListener('DOMContentLoaded', initHover);
      {%- endif -%}
    })();
  </script>
{%- endif -%}
