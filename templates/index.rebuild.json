                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_JQLGHr": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Whey protein and collagen are both food-derived ingredients. The botanicals in Thrive Protein are present in very small amounts. The Cappuccino flavour contains caffeine. As with anything during pregnancy or breastfeeding, please consult your doctor first.</p>",
