                    "width": 24,
                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_JQLGHr": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Add one sachet to 200ml of cold or sparkling water, preferably with ice. Stir well with a spoon or shake in your Lumeia bottle until fully dissolved. Let it sit for 5 minutes for best taste. Due to the number of active ingredients, some natural settling may occur. This is normal and doesn't affect quality. A quick stir or shake brings it back together immediately. Best taken in the morning.</p>",
