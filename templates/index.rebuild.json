                  "blocks": {
                    "text_JQLGHr": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Yes. Both products use food-grade ingredients at safe daily doses. If you are pregnant, breastfeeding, or taking medication, please consult your doctor. The Cappuccino flavour of Thrive Protein contains 58.5mg of caffeine.</p>",
