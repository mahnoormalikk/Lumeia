                "icon": "none",
                "icon_size": "custom-size",
                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_fHUVjG": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No. Each works on its own. But they cover different things. Complete Collagen is your skin ritual (10,500mg collagen + 9 supporting ingredients). Thrive Protein is your body ritual (22g+ protein + 1,500mg collagen + enzymes). Many women use Collagen in the morning and Protein after activity or as a snack.</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
                    "highlight_shape_color": "",
                    "highlight_text_color": "",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_weight": "",
                    "font_size": 15,
                    "font_size_mobile": 15,
                    "line_height": "normal",
                    "text_color": "subtext",
