                  "blocks": {
                    "text_kKGN69": {
                      "type": "text",
                      "settings": {
                        "text": "<p>No. Six flavours across two products. Complete Collagen has three fruit-floral flavours that taste like something you would order at a juice bar. Thrive Protein has three café-inspired flavours including a Cappuccino with real caffeine. None of them are chalky and none of them taste artificial. The flavours are why women stay consistent.</p>",
                        "highlight_style": "none",
                        "highlight_font_style": "italic",
                        "highlight_shape_color": "",
                        "highlight_text_color": "",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
