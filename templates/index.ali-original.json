                  ]
                },
                "accordion_row_iYkREB": {
                  "type": "_accordion-row",
                  "settings": {
                    "text": "Does it taste weird?",
                    "open_row_by_default": false,
                    "icon": "none",
                    "icon_size": "extra-large",
                    "width": 24,
                    "width_mobile": 24
