                  "blocks": {
                    "text_KxMan4": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Both products are manufactured in Europe to EU quality and safety standards, in GMP and IFS Certified facilities. Every batch is independently tested at a Eurofins laboratory.</p>",
