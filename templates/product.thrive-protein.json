              "blocks": {
                "text_bJcUAr": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes! All ingredients and formulas are Halal certified. This is non-negotiable for us. The collagen source is Halal certified at the ingredient level.</p>",
