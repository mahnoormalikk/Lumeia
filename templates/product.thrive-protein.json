            "accordion_row_tViRV4": {
              "type": "_accordion-row",
              "settings": {
                "text": "Does it contain any allergens?",
                "open_row_by_default": false,
                "icon": "none",
                "icon_size": "custom-size",
                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_XUMiBJ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Thrive Protein contains whey protein, which is derived from milk (dairy), and bovine collagen, which is derived from cattle. The Cappuccino flavour also contains instant coffee, providing 58.5mg of caffeine per 30g sachet, and is not recommended for children, pregnant women, or breastfeeding women. <strong>Allergen Information:</strong> May contain soy, gluten, crustaceans, eggs, fish, nuts, celery, sulphites, and molluscs. This is because the product is manufactured in a facility that also handles these allergens. The full ingredients list for each flavour is available on this page. If you have a specific allergy or sensitivity, please consult your doctor before use.</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
                    "highlight_shape_color": "",
                    "highlight_text_color": "",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
