                "width_mobile": 24
              },
              "blocks": {
                "text_eq8VNC": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. Thrive Protein is independently tested for heavy metals and contaminants at an accredited Eurofins laboratory. We test because we want you to verify what you're putting in your body, not just take our word for it. Please contact us if you'd like to view our certificates.</p>",
