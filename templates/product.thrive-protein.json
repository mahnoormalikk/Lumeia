            "accordion_row_jfGeq3": {
              "type": "_accordion-row",
              "settings": {
                "text": "How do I take it?",
                "open_row_by_default": false,
                "icon": "none",
                "icon_size": "custom-size",
                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_qBLUmV": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Add one sachet to 200ml of cold water, milk, or a milk alternative. Stir well or shake in a bottle until fully dissolved. <strong>Hint: </strong>Thrive dissolves best with vigorous shaking or stirring. A quick shake brings it right back if it settles. Chocolate Hazelnut with cold milk is the one to try first. Tahitian vanilla works perfect in recipes!</p>",
