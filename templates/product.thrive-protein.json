            "accordion_row_VxtURF": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "text": "Will Thrive make me bulky?",
                "open_row_by_default": false,
                "icon": "none",
                "icon_size": "extra-large",
                "width": 24,
                "width_mobile": 24
              },
              "blocks": {
                "text_d8eiLa": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No. Gaining significant muscle requires training hard, eating in a calorie surplus, and being consistent for years. A 22-23g protein sachet a day supports the muscle you already have and helps your body recover from daily life. Protein contributes to the maintenance of muscle mass.* It will not change your shape against your will. If you have been told protein makes women bulky, that was misinformation, not a reflection of how protein actually works in the body.</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
                    "highlight_shape_color": "",
                    "highlight_text_color": "",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
