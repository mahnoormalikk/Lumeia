            "accordion_row_hxNEUg": {
              "type": "_accordion-row",
              "settings": {
                "text": "What are hydrolysed collagen peptides?",
                "open_row_by_default": false,
                "icon": "none",
                "icon_size": "custom-size",
                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_FHXjtG": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Collagen molecules are normally too large for your gut to absorb. Breaking them down into smaller pieces — called peptides — lets them pass through into the bloodstream. The collagen in Complete Collagen is broken down further than standard processing, with a study confirming higher absorption.⁴</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
                    "highlight_shape_color": "",
                    "highlight_text_color": "",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
