              "blocks": {
                "text_XUMiBJ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Complete Collagen contains bovine collagen (from cattle). <strong>Allergen Information:</strong> May contain milk, soy, gluten, crustaceans, eggs, fish, nuts, celery, sulphite and molluscs. This is because the product is manufactured in a facility that also handles these allergens. The full ingredients list for each flavour is available on this page. If you have a specific allergy or sensitivity, please consult your doctor before use.</p>",
