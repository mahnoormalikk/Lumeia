<!-- @title -->
<td class="h6">{{ block.settings.title }}</td>

{%- for i in (1..10) -%}
  {%- liquid
    assign checkbox_key = 'checkbox-' | append: i
    assign text_key = 'checkbox_text_' | append: i

    assign checkbox = block.settings[checkbox_key]
    assign checkbox_text = block.settings[text_key]

    if checkbox
      assign icon_name = 'check-circle'
    else
      assign icon_name = 'circle'
    endif
  -%}

  <!-- @row:{{ i }} -->
  <td class="td-checkbox">
    <div class="comparison-item">
      {% render 'icon',
        icon: icon_name,
        size: 'extra-extra-large',
        class: 'shrink-0'
      %}

      {% if checkbox_text != blank %}
        <span class="comparison-item__text">
          {{ checkbox_text }}
        </span>
      {% endif %}
    </div>
  </td>
  <!-- @row:end -->

{%- endfor -%}

<style>
  .comparison-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .comparison-item__text {
    line-height: 1.4;
  }
</style>

