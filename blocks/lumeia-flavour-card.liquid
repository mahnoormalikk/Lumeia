    { "type": "select", "id": "name_font_weight", "label": "Font weight", "default": "", "options": [ {"value":"","label":"Inherit"},{"value":"300","label":"Light"},{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"} ], "visible_if": "{{ block.settings.name_type_preset == 'custom' }}" },
    { "type": "range", "id": "name_font_size", "label": "Font size", "min": 12, "max": 100, "step": 1, "unit": "px", "default": 18, "visible_if": "{{ block.settings.name_type_preset == 'custom' }}" },
