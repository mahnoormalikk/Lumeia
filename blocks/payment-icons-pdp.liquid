<style>
  .lumeia-trust-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0px 0;
    width: 100%;
    margin-top: 0px;
  }

  .lumeia-payment-icons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    width: 100%;
  }

  /* Main Badge container styling */
  .payment-icon-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    border: 1px solid rgba(0, 0, 0, 0.12) !important; 
    border-radius: 5px !important;
    background: rgba(0, 0, 0, 0.01) !important;
    filter: grayscale(100%) !important;
    opacity: 0.7;
    overflow: hidden;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .payment-icon-badge.text-badge {
    padding: 0 10px;
  }

  /* Specific structure fix for your two custom SVGs */
  .payment-icon-badge.custom-svg-badge {
    padding: 0 6px;
    width: auto;
  }

  .payment-icon-badge.custom-svg-badge svg {
    height: 15px !important; /* Forces perfect proportional matching with VISA/MC */
    width: auto !important;
    display: block !important;
  }
  
  .payment-icon-badge:hover {
    opacity: 1;
    border-color: rgba(0, 0, 0, 0.3) !important;
  }

  .payment-icon-badge span {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.6px;
    color: #44190E !important;
    font-family: var(--lumeia-font-ui), sans-serif;
  }

  .lumeia-guarantee-nudge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: 4px;
  }

  .nudge-icon svg {
    color: #44190E !important;
    opacity: 1;
    display: block;
  }

  .nudge-text {
    font-size: 13px;
    margin: 0;
    padding: 0;
    color: #44190E !important;
    opacity: 1;
    text-align: center;
    font-family: var(--lumeia-font-body), sans-serif;
  }

  .lumeia-trust-divider {
    width: 80%;
    border: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    margin: 4px 0;
  }

  .lumeia-secure-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .secure-icon svg {
    color: #44190E !important;
    opacity: 1;
    display: block;
  }

  .secure-text {
    font-size: 11px;
    margin: 0;
    padding: 0;
    color: #44190E !important;
    opacity: 1;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-family: var(--lumeia-font-ui), sans-serif;
    font-weight: 600;
  }
</style>

{% schema %}
{
  "name": "Lumeia Trust Stack",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Lumeia Trust Stack"
    }
  ]
}
{% endschema %}